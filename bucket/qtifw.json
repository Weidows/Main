{
    "version": "4.8.0",
    "description": "A set of tools and utilities to create installers.",
    "homepage": "https://doc.qt.io/qtinstallerframework/ifw-overview.html",
    "license": {
        "identifier": "GPL-3.0-only,Qt Company GPL Exception 1.0",
        "url": "https://code.qt.io/cgit/installer-framework/installer-framework.git/tree/LICENSE.GPL3-EXCEPT"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.qt.io/official_releases/qt-installer-framework/4.8.0/QtInstallerFramework-windows-x64-4.8.0.exe#/dl.7z",
            "hash": "ed12eb95a999579ecbd3f7efae9a525665b979d245c959d88206a11c3a26a03f"
        }
    },
    "bin": [
        [
            "bin\\archivegen.exe",
            "qtifw-archivegen"
        ],
        [
            "bin\\binarycreator.exe",
            "qtifw-binarycreator"
        ],
        [
            "bin\\devtool.exe",
            "qtifw-devtool"
        ],
        [
            "bin\\repogen.exe",
            "qtifw-repogen"
        ]
    ],
    "checkver": {
        "url": "https://download.qt.io/official_releases/qt-installer-framework/",
        "script": [
            "$base = 'https://download.qt.io/official_releases/qt-installer-framework'",
            "$versions = [regex]::Matches($page, 'href=\"([\\d.]+)/\"') | ForEach-Object { $_.Groups[1].Value } | Sort-Object { [version]$_ } -Descending -Unique",
            "foreach ($version in $versions) {",
            "    $release = Invoke-WebRequest \"$base/$version/\" -UseBasicParsing",
            "    if ($release.Content -match 'href=\"QtInstallerFramework-windows-x64-([\\d.]+)\\.exe\"') {",
            "        $Matches[1]",
            "        break",
            "    }",
            "}"
        ],
        "regex": "^([\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.qt.io/official_releases/qt-installer-framework/$version/QtInstallerFramework-windows-x64-$version.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
